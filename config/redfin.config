# Google Pixel 5 (redfin) additional kernel config fragment
# Merged over defconfig + avicii*.config
CONFIG_DRM_PANEL_SAMSUNG_S6E3HC2=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_RD_LZ4=y
CONFIG_RD_XZ=y
CONFIG_RD_ZSTD=y
CONFIG_F2FS_FS=y
CONFIG_FAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_DEFAULT="iso8859-1"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_BPF=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SECCOMP=y
CONFIG_BINFMT_MISC=y

# Ensure USB gadget mode is enabled for Redfin (dr_mode = "peripheral")
CONFIG_USB_DWC3_DUAL_ROLE=n
CONFIG_USB_DWC3_HOST=n
CONFIG_USB_DWC3_GADGET=y

# Speed up CI build by disabling non-Qualcomm ARM64 SoC families, PCI, ACPI, KVM & unused GPUs
CONFIG_ARCH_QCOM=y
# CONFIG_PCI is not set
# CONFIG_ACPI is not set
# CONFIG_KVM is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_INFINIBAND is not set
# CONFIG_ATA is not set
