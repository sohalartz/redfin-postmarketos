#!/bin/sh
# Initramfs for Google Pixel 5 (redfin):
# - USB network (NCM) + serial (ACM) gadget, telnet shell on 172.16.42.1
# - Populates /dev/disk/by-partlabel/* from UFS GPT partitions
# - Mounts stock modem_b/modem_a partition read-only to supply signed MPSS/ADSP/Wi-Fi firmware
# - Starts rmtfs + pd-mapper + MPSS remoteproc for WCN3990 Wi-Fi (wlan0)
# - Draws live hardware status on the Samsung S6E3HC2 OLED panel via DRM/KMS
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs dev /dev
mkdir -p /dev/pts /dev/disk/by-partlabel /run /tmp /mnt/modem
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp
mount -t configfs configfs /sys/kernel/config 2>/dev/null

# Feed hardware watchdog if enabled
[ -c /dev/watchdog0 ] && watchdog -t 5 -T 30 /dev/watchdog0

# Save previous boot ramoops console logs if present
mount -t pstore pstore /sys/fs/pstore 2>/dev/null
mkdir -p /run/prev-boot
cp /sys/fs/pstore/* /run/prev-boot/ 2>/dev/null

hostname redfin
echo 1 > /proc/sys/kernel/sysrq 2>/dev/null

# --- USB gadget (NCM network + ACM serial) ---
G=/sys/kernel/config/usb_gadget/g1
mkdir -p $G
echo 0x1d6b > $G/idVendor
echo 0x0104 > $G/idProduct
mkdir -p $G/strings/0x409
echo redfin-linux > $G/strings/0x409/serialnumber
echo Google > $G/strings/0x409/manufacturer
echo "Pixel 5 Mainline Linux" > $G/strings/0x409/product
mkdir -p $G/configs/c.1/strings/0x409
echo "ncm+acm" > $G/configs/c.1/strings/0x409/configuration
mkdir -p $G/functions/ncm.usb0
echo 02:72:65:64:66:01 > $G/functions/ncm.usb0/host_addr
echo 02:72:65:64:66:02 > $G/functions/ncm.usb0/dev_addr
ln -s $G/functions/ncm.usb0 $G/configs/c.1/
mkdir -p $G/functions/acm.GS0 && ln -s $G/functions/acm.GS0 $G/configs/c.1/

i=0
while [ $i -lt 20 ]; do
	UDC=$(ls /sys/class/udc 2>/dev/null | head -n1)
	[ -n "$UDC" ] && break
	sleep 1; i=$((i + 1))
done
echo "redfin-init: udc=${UDC:-none}" > /dev/kmsg
[ -n "$UDC" ] && echo "$UDC" > $G/UDC

ifconfig lo 127.0.0.1 up
i=0
while [ $i -lt 10 ] && ! ifconfig usb0 >/dev/null 2>&1; do sleep 1; i=$((i + 1)); done
ifconfig usb0 172.16.42.1 netmask 255.255.255.0 up 2>/dev/null

cat > /etc/udhcpd.conf <<EOF
start 172.16.42.2
end 172.16.42.2
interface usb0
option subnet 255.255.255.0
option lease 86400
lease_file /run/udhcpd.leases
EOF
touch /run/udhcpd.leases
if command -v busybox-extras >/dev/null 2>&1; then
	busybox-extras udhcpd /etc/udhcpd.conf
	busybox-extras telnetd -l /bin/sh
else
	udhcpd /etc/udhcpd.conf 2>/dev/null
	telnetd -l /bin/sh 2>/dev/null
fi

# Start dropbear SSH daemon if available
if command -v dropbear >/dev/null 2>&1; then
	mkdir -p /etc/dropbear /root/.ssh
	chmod 700 /root/.ssh
	[ -e /etc/dropbear/dropbear_ed25519_host_key ] || dropbearkey -t ed25519 -f /etc/dropbear/dropbear_ed25519_host_key 2>/dev/null
	dropbear -r /etc/dropbear/dropbear_ed25519_host_key -E -p 22 2>/dev/null || dropbear -r /etc/dropbear/dropbear_ed25519_host_key -B -p 22 2>/dev/null
	echo "redfin-init: dropbear SSH daemon started on port 22" > /dev/kmsg
fi

[ -c /dev/ttyGS0 ] && (while :; do setsid sh -c 'exec sh </dev/ttyGS0 >/dev/ttyGS0 2>&1'; sleep 1; done) &

echo "redfin-init: network up, telnet 172.16.42.1" > /dev/kmsg

# --- Populate /dev/disk/by-partlabel from UFS block devices ---
populate_partlabels() {
	i=0
	while [ $i -lt 15 ]; do
		ls /sys/class/block/sd* >/dev/null 2>&1 && break
		sleep 1; i=$((i + 1))
	done
	for u in /sys/class/block/sd*/uevent; do
		[ -e "$u" ] || continue
		dev=$(basename "$(dirname "$u")")
		part=$(awk -F= '/^PARTNAME=/{print $2}' "$u")
		[ -n "$part" ] && ln -sf "/dev/$dev" "/dev/disk/by-partlabel/$part"
	done
}
populate_partlabels

# --- Mount stock modem partition & wire firmware for MPSS / WCN3990 Wi-Fi ---
setup_firmware_and_wifi() {
	FW_DIR=/lib/firmware/qcom/sm7250/google/redfin
	ATH_DIR=/lib/firmware/ath10k/WCN3990/hw1.0
	mkdir -p "$FW_DIR" "$ATH_DIR"

	for slot in modem_a modem_b; do
		if [ -b "/dev/disk/by-partlabel/$slot" ]; then
			if mount -t vfat -o ro "/dev/disk/by-partlabel/$slot" /mnt/modem 2>/dev/null; then
				echo "redfin-init: mounted $slot at /mnt/modem" > /dev/kmsg
				break
			fi
		fi
	done

	if [ -d /mnt/modem/image ]; then
		for f in /mnt/modem/image/*; do
			[ -e "$f" ] || continue
			base=$(basename "$f")
			[ -e "$FW_DIR/$base" ] || ln -sf "$f" "$FW_DIR/$base"
		done
		[ -e /mnt/modem/image/wlanmdsp.mbn ] && [ ! -e "$ATH_DIR/wlanmdsp.mbn" ] && ln -sf /mnt/modem/image/wlanmdsp.mbn "$ATH_DIR/wlanmdsp.mbn"
	fi

	# Create mountpoint symlinks for tqftpserv
	mkdir -p /readonly/vendor /readonly /var/lib/tqftpserv /run
	ln -sf /mnt/modem /readonly/vendor/firmware_mnt 2>/dev/null
	ln -sf /mnt/modem /readonly/firmware 2>/dev/null

	# Boot MPSS remoteproc (which hosts WCN3990 wlan_pd)
	for r in /sys/class/remoteproc/remoteproc*; do
		[ -e "$r/name" ] || continue
		rname=$(cat "$r/name" 2>/dev/null)
		case "$rname" in
			*mpss*|*modem*)
				state=$(cat "$r/state" 2>/dev/null)
				if [ "$state" != "running" ]; then
					echo "redfin-init: starting remoteproc $rname ($r)" > /dev/kmsg
					echo start > "$r/state" 2>/dev/null
				fi
				;;
		esac
	done

	sleep 1

	# Start Qualcomm userspace services needed by MPSS and wlan_pd
	if command -v tqftpserv >/dev/null 2>&1; then
		tqftpserv -d >/run/tqftpserv.log 2>&1 &
	fi
	if command -v pd-mapper >/dev/null 2>&1; then
		pd-mapper >/run/pdmapper.log 2>&1 &
	fi
	if command -v rmtfs >/dev/null 2>&1; then
		rmtfs -r -P -s >/run/rmtfs.log 2>&1 &
	fi

	# Wait up to 8s for wlan0; if pd-mapper needs re-announcement, restart pd-mapper once
	w=0
	while [ $w -lt 8 ] && [ ! -d /sys/class/net/wlan0 ]; do
		sleep 1; w=$((w + 1))
	done
	if [ ! -d /sys/class/net/wlan0 ] && command -v pd-mapper >/dev/null 2>&1; then
		killall pd-mapper 2>/dev/null
		sleep 1
		pd-mapper &
	fi
	w=0
	while [ $w -lt 10 ] && [ ! -d /sys/class/net/wlan0 ]; do
		sleep 1; w=$((w + 1))
	done
	if [ -d /sys/class/net/wlan0 ]; then
		ifconfig wlan0 up 2>/dev/null
		echo "redfin-init: wlan0 is UP" > /dev/kmsg
		if [ -e /etc/wpa_supplicant.conf ]; then
			mkdir -p /var/run/wpa_supplicant
			wpa_supplicant -B -i wlan0 -c /etc/wpa_supplicant.conf 2>/dev/null
			udhcpc -i wlan0 -b -n 2>/dev/null &
		fi
	fi
}
setup_firmware_and_wifi &

# --- Switch_root to persistent Ubuntu rootfs on UFS (/dev/sda18) ---
if ! grep -qw redfin.boot=ramfs /proc/cmdline; then
	i=0
	while [ $i -lt 10 ]; do
		rootdev=$(findfs LABEL=ubuntu_root 2>/dev/null || findfs LABEL=pmos_root 2>/dev/null) && [ -n "$rootdev" ] && break
		sleep 1; i=$((i + 1))
	done
	mkdir -p /newroot
	if [ -n "$rootdev" ] && mount -o noatime "$rootdev" /newroot; then
		init_bin=""
		[ -x /newroot/sbin/init_ubuntu ] && init_bin=/sbin/init_ubuntu
		[ -z "$init_bin" ] && [ -x /newroot/sbin/init ] && init_bin=/sbin/init
		[ -z "$init_bin" ] && [ -x /newroot/lib/systemd/systemd ] && init_bin=/lib/systemd/systemd

		if [ -n "$init_bin" ]; then
			echo "redfin-init: switching root to persistent Ubuntu rootfs on $rootdev ($init_bin)" > /dev/kmsg
			storagedev=$(findfs LABEL=storage 2>/dev/null)
			if [ -n "$storagedev" ]; then
				mkdir -p /newroot/mnt
				mount -o noatime "$storagedev" /newroot/mnt 2>/dev/null && echo "redfin-init: mounted 111.7GB storage at /mnt" > /dev/kmsg
			fi
			killall watchdog 2>/dev/null
			umount /sys/fs/pstore /sys/kernel/config 2>/dev/null
			for m in dev proc sys run; do mount -o move /$m /newroot/$m; done
			exec switch_root /newroot "$init_bin"
		fi
		umount /newroot 2>/dev/null
	fi
fi

# --- OLED panel status display ---
render_status() {
	{
		echo "Google Pixel 5 Home Server"
		echo "postmarketOS / Linux $(uname -r)"
		echo "----------------------------------"
		echo "CPU : $(nproc)x Kryo 475 (SM7250)"
		FREQ=$(cat /sys/devices/system/cpu/cpu7/cpufreq/scaling_cur_freq 2>/dev/null)
		[ -n "$FREQ" ] && echo "      Prime core @ $((FREQ / 1000)) MHz"
		RAM_TOTAL=$(awk '/MemTotal/{printf "%d MB", $2/1024}' /proc/meminfo)
		RAM_AVAIL=$(awk '/MemAvailable/{printf "%d MB", $2/1024}' /proc/meminfo)
		echo "RAM : $RAM_TOTAL ($RAM_AVAIL free)"
		if [ -e /dev/dri/card0 ]; then
			echo "GPU : Adreno 620 (/dev/dri/card0)"
		else
			echo "GPU : probing..."
		fi
		if [ -d /sys/class/net/wlan0 ]; then
			W_IP=$(ip -4 addr show dev wlan0 2>/dev/null | awk '/inet /{print $2}' | cut -d/ -f1)
			if [ -n "$W_IP" ]; then
				echo "WiFi: PUADHIYE ($W_IP)"
				echo "SSH : ssh root@$W_IP"
			else
				W_MAC=$(cat /sys/class/net/wlan0/address 2>/dev/null)
				echo "WiFi: connecting... ($W_MAC)"
			fi
		else
			echo "WiFi: initializing MPSS/ath10k..."
		fi
		echo "USB : usb0 172.16.42.1 (telnet)"
		echo "Time: up $(cut -d' ' -f1 /proc/uptime)s (Server Online)"
	} > /run/status.txt
}

status_screen() {
	i=0
	while [ $i -lt 20 ] && [ ! -e /dev/dri/card0 ]; do sleep 1; i=$((i + 1)); done
	for b in /sys/class/backlight/*; do
		[ -e "$b/brightness" ] && echo $(( $(cat "$b/max_brightness") / 2 )) > "$b/brightness" 2>/dev/null
	done
	if command -v serverui >/dev/null 2>&1; then
		echo "redfin-init: launching interactive serverui" > /dev/kmsg
		exec serverui
	else
		render_status
		drmtext -s 3 /run/status.txt &
	fi
}
status_screen &

while :; do sleep 3600; done
